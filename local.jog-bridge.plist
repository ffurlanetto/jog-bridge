<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.jog-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/jog-bridge</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Interactive priority: minimal latency for the jog wheels -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardErrorPath</key>
    <string>/tmp/jog-bridge.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/jog-bridge.log</string>
</dict>
</plist>
